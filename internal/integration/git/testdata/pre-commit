#!/usr/bin/env bash
# Rejects files that must never enter this repository. See README.md.
max_bytes=5242880
audio=" wav mp3 m4a aac flac ogg opus webm mp4 mov mkv aiff aif caf wma "
dbs=" sqlite sqlite-wal sqlite-shm db "
meeting_re='^meetings/([a-z0-9][a-z0-9-]*)/([0-9]{4})/([0-9]{4})-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*/[^/]+$'
count=0

reject() {
  echo "pre-commit: rejected $1: $2" >&2
  count=$((count+1))
}

while IFS= read -r -d '' f; do
  base=${f##*/}
  ext=""
  case "$base" in
    *.*) ext=$(printf '%s' "${base##*.}" | tr 'A-Z' 'a-z') ;;
  esac

  if [ -n "$ext" ]; then
    case "$audio" in *" $ext "*) reject "$f" "audio or video file (recordings never enter git)" ;; esac
    [ "$ext" = "jsonl" ] && reject "$f" "Claude Code session log (.jsonl)"
    case "$dbs" in *" $ext "*) reject "$f" "database file" ;; esac
  fi

  size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
  if [ "$size" -gt "$max_bytes" ]; then
    reject "$f" "file over 5 MB ($size bytes)"
  fi

  case "$f" in
    meetings/*)
      [ "$f" = "meetings/.gitkeep" ] && continue
      [ "$f" = "meetings/index.md" ] && continue
      if [[ $f =~ $meeting_re ]] && [ "${BASH_REMATCH[2]}" = "${BASH_REMATCH[3]}" ]; then
        project=${BASH_REMATCH[1]}
        if ! git cat-file -e ":instructions/projects/$project.md" 2>/dev/null; then
          reject "$f" "project \"$project\" has no instructions/projects/$project.md"
        fi
      else
        reject "$f" "meeting files must be at meetings/<project>/<YYYY>/<YYYY-MM-DD>-<slug>/<file>"
      fi
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ "$count" -gt 0 ]; then
  echo "pre-commit: commit blocked ($count file(s)). Unstage with: git restore --staged <file>" >&2
  exit 1
fi
exit 0
